{{ extends "../layouts/base.jet" }}{{ block body() }}  <header class="site-header">
    <div class="container">
      <div class="site-header__bar d-flex align-items-center justify-content-between py-2">
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">DP</span>
          <span class="d-flex flex-column lh-sm">
            <span>DevOps Pulse</span>
            <span class="brand__tag">{{ .Messages["tagline"] }}</span>
          </span>
        </a>

        <div class="site-controls">
          <div class="segmented" role="group" aria-label="{{ .Messages["language group label"] }}">
            <a class="segmented__option{{ if .Language == "es" }} is-active{{ end }}" href="?lang=es" hreflang="es"{{ if .Language == "es" }} aria-current="true"{{ end }}>ES</a>
            <a class="segmented__option{{ if .Language == "en" }} is-active{{ end }}" href="?lang=en" hreflang="en"{{ if .Language == "en" }} aria-current="true"{{ end }}>EN</a>
          </div>
          <div class="segmented" role="group" aria-label="{{ .Messages["theme group label"] }}">
            <button type="button" class="segmented__option" data-theme-option="light" aria-label="{{ .Messages["theme light label"] }}" aria-pressed="false" x-on:click="setTheme('light')" x-bind:aria-pressed="theme === 'light'" x-bind:class="{ 'is-active': theme === 'light' }">
              <svg class="segmented__icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm0 1a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0zm0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13zM16 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 16 8zM3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8z"/></svg>
            </button>
            <button type="button" class="segmented__option" data-theme-option="dark" aria-label="{{ .Messages["theme dark label"] }}" aria-pressed="false" x-on:click="setTheme('dark')" x-bind:aria-pressed="theme === 'dark'" x-bind:class="{ 'is-active': theme === 'dark' }">
              <svg class="segmented__icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.349 8.349 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278z"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </header>
  <main class="container py-5" hx-ext="sse" sse-connect="/metrics?lang={{ .Language }}" @pulse-toggled.document="notify($event.detail)">
    <section class="pulse-heading mb-4">
      <div>
        <p class="eyebrow fg-3 mb-2">{{ .Messages["eyebrow"] }}</p>
        <h1 class="fs-4xl mb-2">{{ .Messages["heading"] }}</h1>
        <p class="fg-3 mb-0">{{ .Messages["subtitle"] }}</p>
      </div>
      <span class="badge rounded-pill" :class="connected ? 'theme-success' : 'theme-warning'" x-text="connected ? '{{ .Messages["live"] }}' : '{{ .Messages["reconnecting"] }}'">{{ .Messages["reconnecting"] }}</span>
    </section>
    <section class="toolbar card border-subtle mb-4">
      <div class="card-body d-flex flex-wrap gap-3 align-items-center">
        <label class="visually-hidden" for="service-search">{{ .Messages["search label"] }}</label>
        <div class="input-group search-box">
          <span class="input-group-text" aria-hidden="true"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.064.078.102.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.119-.099zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/></svg></span>
          <input id="service-search" class="form-control" type="search" placeholder="{{ .Messages["search label"] }}" aria-label="{{ .Messages["search label"] }}" x-model="query">
        </div>
        <span class="fg-3 small">{{ .Messages["updates"] }}</span>
      </div>
    </section>
    <div id="metrics-grid" class="row g-7" sse-swap="metrics" hx-swap="none">
      {{ include "/partials/server-grid.jet" . }}
    </div>
  </main>
  {{ include "/partials/logs-dialog.jet" . }}{{ end }}