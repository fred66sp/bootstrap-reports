<article class="card service-card h-100 border-subtle">
    <div class="card-header d-flex flex-row justify-content-between align-items-center">
      <div class="d-flex flex-row align-items-center gap-2">
        <h2 class="h5 mb-0">{{ .Service.Name }}</h2>
        {{ include "/fragments/status.jet" . }}
      </div>
      <button type="button" class="btn-icon theme-secondary" data-dialog-title="{{ .HelpTitle }}" data-service-id="{{ .Service.ID }}" aria-label="{{ .HelpLabel }}" @click="openHelp($el, '{{ .Service.ID }}')"><svg class="pulse-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 13A6 6 0 1 1 8 2a6 6 0 0 1 0 12zM7.25 5.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0zM7 7h2v5H7V7z"/></svg></button>
    </div>
    <div class="card-body">
      {{ include "/fragments/metrics.jet" . }}
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
      <button class="btn-text theme-primary p-0" type="button" data-dialog-title="{{ .LogsTitle }}" data-service-id="{{ .Service.ID }}" aria-label="{{ .Messages["view logs"] }}: {{ .Service.Name }}" @click="openLogs($el, '{{ .Service.ID }}')">{{ .Messages["view logs"] }}</button>
      <form hx-post="/toggle-service" hx-vals='{"id":"{{ .Service.ID }}","lang":"{{ .Language }}"}' hx-target="closest .card" hx-swap="outerHTML" hx-indicator="#toggle-spinner-{{ .Service.ID }}">
        <button class="btn-outline theme-secondary btn-sm" type="submit"><span class="spinner-border spinner-sm htmx-indicator" id="toggle-spinner-{{ .Service.ID }}" aria-hidden="true"></span><span>{{ .Messages["toggle"] }}</span></button>
      </form>
    </div>
    {{ include "/fragments/logs.jet" . }}
    <div id="help-{{ .Service.ID }}" hidden>
      <p>{{ .Messages["help intro"] }}</p>
      <ul>
        <li>{{ .Messages["help cpu"] }}</li>
        <li>{{ .Messages["help memory"] }}</li>
        <li>{{ .Messages["help status"] }}</li>
      </ul>
      <p>{{ .Messages["help logs"] }}</p>
      <p>{{ .Messages["help disclaimer"] }}</p>
    </div>
  </article>