<div id="metrics-{{ .Service.ID }}"{{ if .OutOfBand }} hx-swap-oob="true"{{ end }}><div class="metric-row"><div class="d-flex justify-content-between small mb-2"><span>{{ .Messages["cpu"] }}</span><span>{{ .Service.CPU }}%</span></div><div class="progress" role="progressbar" aria-label="{{ .Messages["cpu"] }}" aria-valuenow="{{ .Service.CPU }}" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar theme-primary" style="width: {{ .Service.CPU }}%">{{ .Service.CPU }}%</div></div></div><div class="metric-row"><div class="d-flex justify-content-between small mb-2"><span>{{ .Messages["ram"] }}</span><span>{{ .Service.RAM }}%</span></div><div class="progress" role="progressbar" aria-label="{{ .Messages["ram"] }}" aria-valuenow="{{ .Service.RAM }}" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar theme-info" style="width: {{ .Service.RAM }}%">{{ .Service.RAM }}%</div></div></div></div>